{% set secrets = pillar['livekit']['credentials'] %}
{% set livekit = pillar["livekit"] %}
port: 7880
log_level: info
rtc:
  node_ip: {{ livekit["node_ip"] | tojson }}
  use_external_ip: false
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
redis:
  address: 127.0.0.1:6379
  password: {{ secrets["REDIS_PASSWORD"] | tojson }}
keys:
  {{ pillar["rtc"]["key"] | tojson }}: {{ pillar["rtc"]["secret"] | tojson }}
turn:
  enabled: true
  domain: {{ livekit["turn_host"] | tojson }}
  tls_port: 5349
  udp_port: 3478
  relay_range_start: 30000
  relay_range_end: 40000
  external_tls: true
  proxy_protocol: true
  proxy_protocol_trusted_cidrs:
    - 127.0.0.0/8
    - ::1/128
