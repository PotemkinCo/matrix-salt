{% set mas = pillar['matrix']['mas'] %}
{% set tls = pillar['tls'] %}
{% set rate_window_seconds = 10 %}
{% set login_http_req_limit = (mas['login_per_ip_burst']|int + (mas['login_per_ip_per_second']|float * rate_window_seconds)|round(0, 'ceil')|int) %}
{% set registration_http_req_limit = (mas['registration_burst']|int + (mas['registration_per_second']|float * rate_window_seconds)|round(0, 'ceil')|int) %}
global
    log /dev/log local0
    chroot /var/lib/haproxy
    user haproxy
    group haproxy
    daemon
    setenv ACCOUNT_THUMBPRINT '{{ tls['acme_account_thumbprint'] }}'
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-load-extra-files key

defaults
    log global
    mode http
    option httplog
    timeout connect 5s
    timeout client 1h
    timeout server 1h

frontend acme_http
    bind :80
    http-request return status 200 content-type text/plain lf-string "%[path,field(-1,/)].${ACCOUNT_THUMBPRINT}\n" if { path_reg ^/.well-known/acme-challenge/[-_a-zA-Z0-9]+$ }
    http-request redirect scheme https code 308

frontend matrix_https
    bind :443 ssl crt /etc/haproxy/certs/{{ tls["cert_name"] }}.pem alpn h2,http/1.1
    bind quic4@:443 ssl crt /etc/haproxy/certs/{{ tls["cert_name"] }}.pem alpn h3
    # Overwrite (not append to) X-Forwarded-For so downstream services can trust it.
    http-request set-header X-Forwarded-For %[src]
    http-request set-header X-Forwarded-Proto https
    http-after-response set-header alt-svc 'h3=":443";ma=900;'
    http-after-response set-header Strict-Transport-Security "max-age=31536000"
    http-request return status 404 unless { hdr(host) -i {{ pillar['matrix']['server']['name'] }} }
    http-request return status 418 content-type text/plain string "I'm a teapot" if { path -i / }
    # MAS owns the post-registration redirect; preserve explicit OAuth continuation queries.
    http-request set-query kind=manage_account if { path -i /register /register/password } !{ query -m found }
    acl well_known_client method GET
    acl well_known_client_path path -i /.well-known/matrix/client
    http-request return status 200 content-type application/json file /etc/haproxy/well-known-client.json hdr Access-Control-Allow-Origin "*" hdr Cache-Control "max-age=3600" if well_known_client well_known_client_path
    # Legacy local RTC verifies OpenID tokens through server discovery; this is not event federation.
    http-request return status 200 content-type application/json file /etc/haproxy/well-known-server.json if { method GET } { path -i /.well-known/matrix/server }
    acl synapse_federation_path path_beg /_matrix/federation /_matrix/key /_matrix/server
    http-request return status 404 if synapse_federation_path !{ path -i /_matrix/federation/v1/openid/userinfo }
    http-request return status 404 if { path -i /_matrix/federation/v1/openid/userinfo } !{ method GET }
    acl mas_compat path_reg ^/_matrix/client/[^/]+/(login|logout|refresh)/?$
    acl synapse_path path_beg /_matrix/ /_synapse/client/rendezvous/
    acl jwt_path path -i /sfu/get /get_token /delegate_delayed_leave /sfu_webhook
    acl mas_path path -i /login /logout /register /account /authorize /link /recover /.well-known/openid-configuration /.well-known/webfinger /.well-known/change-password
    # /graphql and /assets/ serve the MAS account/login SPA and must stay public; the MAS admin
    # API (/api/admin/v1/) is not enabled in this deployment.
    acl mas_prefix path_beg /register/ /account/ /consent/ /link/ /device/ /recover/ /upstream/ /complete-compat-sso/ /oauth2/ /graphql /assets/

    # Bound POSTed password attempts and registration submissions by source IP.
    # The 10-second window uses the configured MAS burst plus per-second budgets.
    acl auth_post method POST
    acl auth_path path -i /login
    acl auth_path path_reg ^/_matrix/client/[^/]+/login$
    http-request track-sc0 src table matrix_auth_rate_limits if auth_post auth_path
    acl auth_rate_exceeded sc_http_req_rate(0) gt {{ login_http_req_limit }}
    http-request deny deny_status 429 if auth_post auth_path auth_rate_exceeded

    acl registration_post method POST
    acl registration_path path -i /register
    acl registration_path path_reg ^/_matrix/client/[^/]+/register$
    http-request track-sc1 src table matrix_registration_rate_limits if registration_post registration_path
    acl registration_rate_exceeded sc_http_req_rate(1) gt {{ registration_http_req_limit }}
    http-request deny deny_status 429 if registration_post registration_path registration_rate_exceeded

    use_backend mas if mas_compat
    use_backend synapse if synapse_path
    use_backend jwt if jwt_path
    use_backend mas if mas_path or mas_prefix
    default_backend matrix_not_found

backend synapse
    server synapse 127.0.0.1:8008 check

backend mas
    server mas 127.0.0.1:8082 check

backend jwt
    server jwt 127.0.0.1:9013 check

backend matrix_not_found
    http-request return status 404 content-type text/plain string "Not Found"

backend matrix_auth_rate_limits
    stick-table type ip size 100k expire 30s store http_req_rate({{ rate_window_seconds }}s)

backend matrix_registration_rate_limits
    stick-table type ip size 100k expire 30s store http_req_rate({{ rate_window_seconds }}s)
